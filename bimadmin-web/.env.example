# Copy this file to .env and fill in your own values. Never commit .env.
# Nothing in this repository contains a real key — that would be exactly
# the "exposed API key" problem this rewrite exists to avoid.

# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key above is meant to be public (it is restricted by row level
# security policies in supabase/migrations/0001_init.sql). Your service
# role key and payment provider secrets must NEVER go in this file or in
# any file shipped to the browser — they belong only in Supabase Edge
# Function secrets, set with:
#
#   supabase secrets set MPESA_CONSUMER_KEY=...
#   supabase secrets set MPESA_CONSUMER_SECRET=...
#   supabase secrets set MPESA_SHORTCODE=...
#   supabase secrets set MPESA_PASSKEY=...
#   supabase secrets set MPESA_CALLBACK_URL=https://your-project-ref.functions.supabase.co/mpesa-callback
#   supabase secrets set MPESA_CALLBACK_SECRET=...      (generate with `openssl rand -hex 32`, keep it secret)
#   supabase secrets set MPESA_ENV=sandbox
#   supabase secrets set PAYSTACK_SECRET_KEY=...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   (Edge Functions only, never the browser)
#
# Real communications (all optional -- each send function returns a
# clear "not configured" error until its secrets are set):
#   supabase secrets set RESEND_API_KEY=...
#   supabase secrets set RESEND_FROM_EMAIL=you@your-verified-domain.com
#   supabase secrets set AFRICASTALKING_USERNAME=...
#   supabase secrets set AFRICASTALKING_API_KEY=...
#   supabase secrets set AFRICASTALKING_SENDER_ID=...    (optional)
#   supabase secrets set WHATSAPP_ACCESS_TOKEN=...       (requires Meta Business approval first)
#   supabase secrets set WHATSAPP_PHONE_NUMBER_ID=...
#
# Real recurring card billing (optional, only matters if you use Paystack):
#   supabase secrets set CHARGE_JOB_SECRET=$(openssl rand -hex 32)
#
# CHARGE_JOB_SECRET must also be pasted into charge_due_card_renewals()
# in supabase/migrations/0006_recurring_card_billing.sql, along with your
# real Edge Function URL, before running that migration -- see the
# TODO comments in that file.
#
# Supabase secrets are shared across all of your project's Edge Functions,
# so setting each of these once makes it available to both mpesa-stk-push
# and mpesa-callback -- you do not need to set them twice.

# Optional, privacy-friendly analytics (for example Plausible). Leave blank
# to load nothing and show no cookie banner at all.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
